<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.duoc.vivero.controller.PrincipalController"
            stylesheets="@styles.css" styleClass="vista">
    <top>
        <VBox spacing="12">
            <Label text="Vivero Hojas del Sur" styleClass="titulo"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Buscar por nombre:"/>
                <TextField fx:id="txtBuscar" promptText="Escribe parte del nombre" HBox.hgrow="ALWAYS"/>
            </HBox>
            <padding><Insets bottom="12"/></padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblPlantas">
            <placeholder>
                <Label text="No hay plantas para mostrar. Usa &quot;Agregar&quot; para registrar una."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="240"/>
                <TableColumn fx:id="colAltura" text="Altura (cm)" prefWidth="110" styleClass="numero"/>
                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100" styleClass="numero"/>
                <TableColumn fx:id="colPrecio" text="Precio unitario" prefWidth="130" styleClass="numero"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="btnAgregar" text="Agregar" onAction="#onAgregar" styleClass="primario"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" styleClass="peligro"/>
            </HBox>
            <Label fx:id="lblMensaje" styleClass="resultado" wrapText="true" minHeight="22"/>
            <padding><Insets top="12"/></padding>
        </VBox>
    </bottom>
</BorderPane>
